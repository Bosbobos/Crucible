      "type": "integer"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "title": "Event Type",
      "type": "string"
    },
    "producer": {
      "title": "Producer",
      "type": "string"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "source_seq": {
      "minimum": 1,
      "title": "Source Seq",
      "type": "integer"
    },
    "aggregate_id": {
      "title": "Aggregate Id",
      "type": "string"
    },
    "aggregate_revision": {
      "minimum": 1,
      "title": "Aggregate Revision",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
