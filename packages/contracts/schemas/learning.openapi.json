              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Plan": {
        "additionalProperties": false,
        "properties": {
          "command_id": {
            "format": "uuid",
            "title": "Command Id",
            "type": "string"
          },
          "expected_revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Revision"
          },
          "refresh": {
            "default": false,
            "title": "Refresh",
            "type": "boolean"
          }
        },
        "required": [
          "command_id"
        ],
        "title": "Plan",
        "type": "object"
      },
      "Settings": {
        "additionalProperties": false,
        "properties": {
          "command_id": {
            "format": "uuid",
            "title": "Command Id",
            "type": "string"
          },
          "daily_count": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Daily Count",
            "type": "integer"
          },
          "expected_revision": {
            "minimum": 1.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "timezone": {
            "maxLength": 64,
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "command_id",
          "expected_revision",
          "timezone",
          "daily_count"
        ],
        "title": "Settings",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
