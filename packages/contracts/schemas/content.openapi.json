            "maxLength": 150,
            "minLength": 1,
            "title": "Reward Equivalence Id",
            "type": "string"
          },
          "rubric_version": {
            "maxLength": 150,
            "minLength": 1,
            "title": "Rubric Version",
            "type": "string"
          },
