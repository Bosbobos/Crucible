{
  "components": {
    "schemas": {
      "AssessmentBinding": {
        "additionalProperties": false,
        "properties": {
          "problem_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 6,
            "minItems": 4,
            "title": "Problem Ids",
            "type": "array"
          },
          "publication_version": {
            "maxLength": 150,
            "minLength": 1,
            "title": "Publication Version",
            "type": "string"
          },
          "variant_id": {
            "maxLength": 150,
            "minLength": 1,
            "title": "Variant Id",
            "type": "string"
          }
        },
        "required": [
          "variant_id",
          "publication_version",
          "problem_ids"
        ],
        "title": "AssessmentBinding",
        "type": "object"
      },
      "Campaign": {
        "additionalProperties": false,
        "properties": {
          "assessments": {
            "additionalProperties": {
              "$ref": "#/components/schemas/AssessmentBinding"
            },
            "title": "Assessments",
            "type": "object"
          },
          "content_release_id": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Content Release Id",
            "type": "string"
          },
          "problems": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ProblemBinding"
            },
            "title": "Problems",
            "type": "object"
          },
          "publication_version": {
            "maxLength": 150,
            "minLength": 1,
            "title": "Publication Version",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "training_family_ids": {
            "items": {
              "type": "string"
            },
            "title": "Training Family Ids",
            "type": "array"
          },
          "units": {
            "additionalProperties": {
              "$ref": "#/components/schemas/UnitBinding"
            },
            "title": "Units",
            "type": "object"
          },
          "volumes": {
            "additionalProperties": {
              "$ref": "#/components/schemas/VolumeBinding"
            },
            "title": "Volumes",
            "type": "object"
          }
        },
        "required": [
          "publication_version",
          "content_release_id",
          "volumes",
          "units",
          "problems",
          "assessments"
        ],
        "title": "Campaign",
        "type": "object"
      },
      "CampaignPublication": {
        "additionalProperties": false,
        "properties": {
          "campaign": {
            "$ref": "#/components/schemas/Campaign"
          },
          "command_id": {
            "format": "uuid",
            "title": "Command Id",
            "type": "string"
          },
          "expected_revision": {
            "minimum": 0.0,
            "title": "Expected Revision",
            "type": "integer"
          }
        },
        "required": [
          "command_id",
          "expected_revision",
          "campaign"
        ],
        "title": "CampaignPublication",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ProblemBinding": {
        "additionalProperties": false,
        "properties": {
          "content_version": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Content Version",
            "type": "string"
          },
