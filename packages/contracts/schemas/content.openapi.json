          "discipline_id",
          "family_id",
          "reward_equivalence_id",
          "rubric_version",
          "mapping_version",
          "content_version",
          "difficulty",
          "pool"
        ],
        "title": "ProblemBinding",
        "type": "object"
      },
      "Publication": {
        "additionalProperties": false,
        "properties": {
          "bundle": {
            "additionalProperties": true,
            "title": "Bundle",
            "type": "object"
          },
          "command_id": {
            "format": "uuid",
            "title": "Command Id",
            "type": "string"
          }
        },
        "required": [
          "command_id",
          "bundle"
        ],
        "title": "Publication",
        "type": "object"
      },
      "UnitBinding": {
        "additionalProperties": false,
        "properties": {
          "content_version": {
            "title": "Content Version",
            "type": "string"
          },
          "unit_kind": {
            "enum": [
              "theory_section",
              "core",
              "lab",
              "volume_final_check"
