# Docker CLI копируется отдельно: daemon внутри оператора не запускается.
FROM docker:28-cli@sha256:625d9431a9f54c5a2bc90f24f0e1c3d55b1349fd857dd85035f98c2c9acbdd4d AS docker_cli
# Python остаётся внутри контейнера с уже зафиксированными зависимостями.
FROM python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535
# Единый каталог используется для обычных тестов без host mounts.
WORKDIR /app
# Lock фиксирует точные версии Python-пакетов.
COPY requirements.lock .
# Зависимости устанавливаются в образ, а не в окружение компьютера.
RUN pip install --no-cache-dir -r requirements.lock
# CLI обращается к внешнему Docker Engine через операторский socket.
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
# Compose — CLI plugin, его также не требуется устанавливать в Python.
COPY --from=docker_cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
# Код и данные тестов не включают .private, секреты и исходный vault.
COPY packages ./packages
COPY apps ./apps
COPY scripts ./scripts
COPY tests ./tests
COPY content ./content
COPY migrations ./migrations
COPY pytest.ini .
# Импорты используют Linux-пакеты образа; host .deps не подключается.
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/packages:/app/apps:/app/scripts CRUCIBLE_IN_CONTAINER=1 DOCKER_CONFIG=/tmp/docker
# В контейнере запускается запрошенная Python-команда.
ENTRYPOINT ["python"]
