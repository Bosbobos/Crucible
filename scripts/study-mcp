#!/bin/sh
# Ошибки Docker должны завершать MCP-процесс с ненулевым кодом.
set -eu
# Переходим к Compose-файлам проекта.
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
# Подключаем общий выбор daily/assessment.
. scripts/compose.sh
# При первой регистрации создаём образ; логи сборки идут только в stderr.
if ! docker image inspect paladin/mcp:0.3.0 >/dev/null 2>&1; then crucible_compose build study-mcp >&2; fi
# Передаём stdin/stdout напрямую контейнеру без TTY и без Docker socket.
if [ "${CRUCIBLE_ASSESSMENT:-0}" = 1 ]; then
    # Расширенный стенд использует свои scoped credentials и собственный project.
    exec docker compose -f compose.yaml -f compose.assessment.yaml -p "${CRUCIBLE_ASSESSMENT_PROJECT:-crucible-assessment}" run --rm -T --no-deps study-mcp
else # Выбираем альтернативную ветку того же условия.
    # Daily использует обычный Compose project и файл mcp.json только для чтения.
    exec docker compose run --rm -T --no-deps study-mcp
fi # Завершаем выбор стенда; stdout принадлежит только MCP.
