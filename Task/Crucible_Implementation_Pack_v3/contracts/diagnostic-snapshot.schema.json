{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnostic result snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "volume_id",
    "check_id",
    "check_version",
    "correct_count",
    "total_count",
    "completed_at",
    "owner_confirmed"
  ],
  "properties": {
    "volume_id": {
      "type": "string",
      "minLength": 1
    },
    "check_id": {
      "type": "string",
      "minLength": 1
    },
    "check_version": {
      "type": "string",
      "minLength": 1
    },
    "correct_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_count": {
      "type": "integer",
      "minimum": 1
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner_confirmed": {
      "type": "boolean"
    }
  }
}
